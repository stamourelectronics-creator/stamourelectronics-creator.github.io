rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global safety net - Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions

    // Check if user is signed in with standard attributes
    function isSignedIn() {
      return request.auth != null;
    }

    // Checked if email is verified
    function isVerifiedUser() {
      return isSignedIn() && (
        request.auth.token.email_verified == true ||
        request.auth.token.firebase.sign_in_provider == 'google.com'
      );
    }

    // Validation for simple unique alphanumeric IDs and bounding length
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // 2. Leaderboard Snake high-score records
    match /leaderboard_snake/{scoreId} {
      allow read: if true; // Public list and details
      
      allow create: if (
        isVerifiedUser() &&
        // Strict Schema Validation
        request.resource.data.keys().hasAll(['name', 'score', 'date', 'skin', 'createdAt']) &&
        request.resource.data.keys().size() == 5 &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 64 &&
        request.resource.data.score is int &&
        request.resource.data.score >= 0 &&
        request.resource.data.score <= 10000000 &&
        request.resource.data.date is string &&
        request.resource.data.date.size() <= 10 &&
        request.resource.data.skin is string &&
        request.resource.data.skin.size() <= 64 &&
        request.resource.data.createdAt == request.time
      );

      // Scores are immutable for clients to prevent vandalism/hacking
      allow update, delete: if false;
    }

    // 3. User Custom Snake Designs
    match /user_snake_skins/{skinId} {
      // Users can only retrieve their own custom snake designs
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow create: if (
        isVerifiedUser() &&
        request.resource.data.userId == request.auth.uid &&
        // Strict Schema Validation
        request.resource.data.keys().hasAll(['userId', 'name', 'gradientStart', 'gradientEnd', 'glow', 'emoji', 'createdAt']) &&
        request.resource.data.keys().size() == 7 &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 64 &&
        request.resource.data.gradientStart is string &&
        request.resource.data.gradientStart.size() <= 32 &&
        request.resource.data.gradientEnd is string &&
        request.resource.data.gradientEnd.size() <= 32 &&
        request.resource.data.glow is bool &&
        request.resource.data.emoji is string &&
        request.resource.data.emoji.size() <= 8 &&
        request.resource.data.createdAt == request.time
      );

      // Custom skin designs are immutable for clients after saving
      allow update: if false;

      // Users can only delete their own custom snake skins
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // 4. Published Sandbox Games (Autonomous AI Playground compilation output)
    match /published_games/{gameId} {
      allow read: if true; // Public exploration directory

      allow create: if (
        isVerifiedUser() &&
        // Strict Schema Validation
        request.resource.data.keys().hasAll(['title', 'genre', 'tagline', 'rules', 'codeHtml', 'createdAt', 'authorName']) &&
        request.resource.data.keys().size() == 7 &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 &&
        request.resource.data.title.size() <= 128 &&
        request.resource.data.genre is string &&
        request.resource.data.genre.size() <= 64 &&
        request.resource.data.tagline is string &&
        request.resource.data.tagline.size() <= 256 &&
        request.resource.data.rules is list &&
        request.resource.data.rules.size() <= 15 &&
        request.resource.data.codeHtml is string &&
        request.resource.data.codeHtml.size() > 0 &&
        request.resource.data.codeHtml.size() <= 524288 && // Limit code size to 512KB for security/abuse
        request.resource.data.createdAt == request.time &&
        request.resource.data.authorName is string &&
        request.resource.data.authorName.size() <= 128
      );

      // Creative sandboxed games are immutable for direct client updates/deletes to safeguard integrity
      allow update, delete: if false;
    }

    // 5. User Profiles
    match /user_profiles/{userId} {
      allow get: if true;
      allow list: if false;
      allow create, update: if (
        isVerifiedUser() &&
        request.auth.uid == userId &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.username is string &&
        request.resource.data.username.size() > 0 &&
        request.resource.data.username.size() <= 64
      );
    }

    // 6. Cloud persistent conversation logs
    match /user_chats/{chatId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create, update: if (
        isVerifiedUser() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.keys().hasAll(['userId', 'id', 'title', 'messages', 'updatedAt']) &&
        request.resource.data.keys().size() == 5 &&
        request.resource.data.userId is string &&
        request.resource.data.id is string &&
        request.resource.data.title is string &&
        request.resource.data.title.size() <= 128 &&
        request.resource.data.messages is list &&
        request.resource.data.messages.size() <= 150
      );
    }

    // 7. Cloud saved AI synthesized web games
    match /user_saved_games/{gameId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create, update: if (
        isVerifiedUser() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.keys().hasAll(['userId', 'title', 'genre', 'tagline', 'rules', 'codeHtml', 'createdAt']) &&
        request.resource.data.keys().size() == 7 &&
        request.resource.data.userId is string &&
        request.resource.data.title is string &&
        request.resource.data.title.size() <= 128 &&
        request.resource.data.genre is string &&
        request.resource.data.genre.size() <= 64 &&
        request.resource.data.tagline is string &&
        request.resource.data.tagline.size() <= 256 &&
        request.resource.data.rules is list &&
        request.resource.data.codeHtml is string &&
        request.resource.data.codeHtml.size() <= 524288
      );
    }

    // 8. Beta Requests
    match /beta_requests/{requestId} {
      allow create: if true; // Allow anyone to submit a request
      allow read, update, delete: if isSignedIn() && request.auth.token.email == 'azndibroblox2@gmail.com';
    }

    // 9. Authorized Emails
    match /authorized_emails/{email} {
      // Allow users to check their own authorization status
      allow get: if isSignedIn() && (request.auth.token.email == email || request.auth.token.email == 'azndibroblox2@gmail.com');
      allow list, create, update, delete: if isSignedIn() && request.auth.token.email == 'azndibroblox2@gmail.com';
    }

    // 10. Live Shared Chats (Real-time live conversation room sync)
    match /shared_chats/{shareId} {
      allow read: if true;
      allow create, update: if (
        request.resource.data.keys().hasAll(['id', 'title', 'messages', 'updatedAt']) &&
        request.resource.data.id is string &&
        request.resource.data.title is string &&
        request.resource.data.title.size() <= 256 &&
        request.resource.data.messages is list &&
        request.resource.data.messages.size() <= 300
      );
      allow delete: if isSignedIn();
    }

    // 11. User Browser Bookmarks (Synchronized to Google Account)
    match /user_bookmarks/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

  }
}
