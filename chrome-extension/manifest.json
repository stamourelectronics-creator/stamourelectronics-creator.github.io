{
  "manifest_version": 3,
  "name": "IsaiahAI",
  "version": "1.4.0",
  "description": "IsaiahAI chat from the Chrome toolbar, with optional context from the active webpage or visible screen.",
  "permissions": ["storage", "tabs", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "action": { "default_title": "Chat with IsaiahAI", "default_popup": "popup.html" },
  "background": { "service_worker": "service_worker.js" },
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle" }
  ],
  "options_page": "options.html"
}