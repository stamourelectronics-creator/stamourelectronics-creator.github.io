{
  "name": "isaiahsearch-browser",
  "productName": "IsaiahSearch",
  "version": "1.6.10",
  "description": "IsaiahSearch desktop browser and IsaiahAI agent for Windows and Ubuntu, with multi-command project task batches and read-only whole-machine Windows diagnostics.",
  "main": "main.cjs",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "npm run dist:win && npm run dist:linux",
    "dist:win": "electron-builder --win nsis portable --publish never && npm run write-update-manifest -- win",
    "prepare:linux-icon": "rsvg-convert -w 512 -h 512 build/icon.svg -o build/icon.png",
    "dist:linux": "npm run prepare:linux-icon && electron-builder --linux AppImage deb --publish never && npm run write-update-manifest -- linux",
    "check": "node --check main.cjs && node --check preload.cjs && node scripts/check-renderer.cjs",
    "write-update-manifest": "node scripts/write-update-manifest.cjs"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.stamourelectronics.isaiahsearch",
    "productName": "IsaiahSearch",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "index.html",
      "assets/**",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "IsaiahSearch-Setup-${version}-${arch}.${ext}",
      "icon": "build/icon.svg",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "IsaiahSearch-Portable-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "IsaiahSearch-${version}-${arch}.${ext}",
      "category": "Network",
      "icon": "build/icon.png",
      "maintainer": "Stamour Electronics",
      "syncDesktopName": true
    },
    "protocols": [
      {
        "name": "IsaiahSearch Browser Link",
        "schemes": [
          "isaiahsearch",
          "web+isaiahsearch"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "stamourelectronics-creator",
        "repo": "stamourelectronics-creator.github.io"
      }
    ]
  },
  "author": "Stamour Electronics",
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "homepage": "https://stamourelectronics-creator.github.io/",
  "desktopName": "com.stamourelectronics.isaiahsearch"
}
