{
  "name": "isaiahsearch-browser",
  "productName": "IsaiahSearch",
  "version": "1.4.1",
  "description": "IsaiahSearch full-window Windows browser with integrated IsaiahAI CodePro, Breakaway 1.0 backup routing, native Chromium tabs, and automatic GitHub release updates.",
  "main": "main.cjs",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable --publish never && npm run write-update-manifest",
    "check": "node --check main.cjs && node --check preload.cjs && node scripts/check-renderer.cjs",
    "write-update-manifest": "node scripts/write-update-manifest.cjs"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.stamourelectronics.isaiahsearch",
    "productName": "IsaiahSearch",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "index.html",
      "assets/**",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "IsaiahSearch-Setup-${version}-${arch}.${ext}",
      "icon": "build/icon.svg",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "IsaiahSearch-Portable-${version}-${arch}.${ext}"
    },
    "protocols": [
      {
        "name": "IsaiahSearch Browser Link",
        "schemes": [
          "isaiahsearch",
          "web+isaiahsearch"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "stamourelectronics-creator",
        "repo": "stamourelectronics-creator.github.io"
      }
    ]
  },
  "author": "Stamour Electronics",
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
