{
  "name": "isaiahai-agent",
  "productName": "IsaiahAI Agent",
  "version": "1.0.2",
  "description": "IsaiahAI desktop agent with Chromium browsing, persistent scoped workspaces, multi-file context and approval-gated terminal tools.",
  "main": "main.cjs",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable",
    "check": "node --check main.cjs && node --check preload.cjs && node scripts/check-renderer.cjs"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.stamourelectronics.isaiahai.agent",
    "productName": "IsaiahAI Agent",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "index.html",
      "assets/**",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "IsaiahAI-Agent-${version}-${arch}.${ext}",
      "icon": "build/icon.svg"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "build/icon.svg",
      "uninstallerIcon": "build/icon.svg"
    },
    "portable": {
      "artifactName": "IsaiahAI-Agent-Portable-${version}-${arch}.${ext}"
    }
  }
}
